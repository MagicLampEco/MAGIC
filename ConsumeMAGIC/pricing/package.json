{
  "name": "@magiclamp/consumemagic-pricing",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/cjs/price.js",
  "module": "./dist/esm/price.js",
  "types": "./dist/esm/price.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/price.d.ts",
      "import": "./dist/esm/price.js",
      "require": "./dist/cjs/price.js"
    }
  },
  "files": ["dist", "src", "prepare.mjs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "prepare": "node prepare.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@magiclamp/protocol-utils": "file:../../ProtocolUtils"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
