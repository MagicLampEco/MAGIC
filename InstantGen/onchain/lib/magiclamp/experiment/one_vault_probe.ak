// ── depth 8 · (ii) thành viên trên cây PhoenixKey ──────────────────────────
test d8_membership_live_ok() {
  verify(phoenix_root_d8, key_alice_d8, Live, phoenix_siblings_d8)
}

test d8_membership_rejects_one_flipped_sibling() {
  !verify(phoenix_root_d8, key_alice_d8, Live, phoenix_siblings_flipped_d8)
}

test d8_membership_rejects_other_member_key() {
  !verify(phoenix_root_d8, key_bob_d8, Live, phoenix_siblings_d8)
}

test d8_membership_rejects_key_off_by_last_bit() {
  !verify(phoenix_root_d8, key_alice_last_bit_flipped_d8, Live, phoenix_siblings_d8)
}

test d8_membership_rejects_wrong_status() {
  !verify(phoenix_root_d8, key_alice_d8, Absent, phoenix_siblings_d8)
}

test d8_membership_rejects_truncated_path() {
  !verify(phoenix_root_d8, key_alice_d8, Live, phoenix_siblings_truncated_d8)
}

// ── depth 8 · (iv) chuyển trạng thái Absent → Live trên accumulator vault ──
test d8_register_first_vault_ok() {
  register_transition_ok(vault_root_old_d8, vault_root_new_d8, key_alice_d8, Absent, vault_siblings_d8)
}

// Mở vault lần hai: gốc hiện tại đã có alice Live, khai Absent để lọt cổng.
test d8_register_rejects_second_vault_claiming_absent() {
  !register_transition_ok(vault_root_new_d8, vault_root_new_d8, key_alice_d8, Absent, vault_siblings_d8)
}

// Mở vault lần hai, khai thật Live: bị chặn ngay ở old_status != Live.
test d8_register_rejects_second_vault_claiming_live() {
  !register_transition_ok(vault_root_new_d8, vault_root_new_d8, key_alice_d8, Live, vault_siblings_d8)
}

test d8_register_rejects_bogus_new_root() {
  !register_transition_ok(vault_root_old_d8, vault_root_bogus_d8, key_alice_d8, Absent, vault_siblings_d8)
}

test d8_register_rejects_one_flipped_sibling() {
  !register_transition_ok(vault_root_old_d8, vault_root_new_d8, key_alice_d8, Absent, vault_siblings_flipped_d8)
}

// ── depth 8 · (ii)+(iv) trong CÙNG một lần chạy ────────────────────────────
test d8_membership_and_register_ok() {
  and {
    verify(phoenix_root_d8, key_alice_d8, Live, phoenix_siblings_d8),
    register_transition_ok(vault_root_old_d8, vault_root_new_d8, key_alice_d8, Absent, vault_siblings_d8),
  }
}

// ── depth 256 · (ii) thành viên trên cây PhoenixKey ──────────────────────────
test d256_membership_live_ok() {
  verify(phoenix_root_d256, key_alice_d256, Live, phoenix_siblings_d256)
}

test d256_membership_rejects_one_flipped_sibling() {
  !verify(phoenix_root_d256, key_alice_d256, Live, phoenix_siblings_flipped_d256)
}

test d256_membership_rejects_other_member_key() {
  !verify(phoenix_root_d256, key_bob_d256, Live, phoenix_siblings_d256)
}

test d256_membership_rejects_key_off_by_last_bit() {
  !verify(phoenix_root_d256, key_alice_last_bit_flipped_d256, Live, phoenix_siblings_d256)
}

test d256_membership_rejects_wrong_status() {
  !verify(phoenix_root_d256, key_alice_d256, Absent, phoenix_siblings_d256)
}

test d256_membership_rejects_truncated_path() {
  !verify(phoenix_root_d256, key_alice_d256, Live, phoenix_siblings_truncated_d256)
}

// ── depth 256 · (iv) chuyển trạng thái Absent → Live trên accumulator vault ──
test d256_register_first_vault_ok() {
  register_transition_ok(vault_root_old_d256, vault_root_new_d256, key_alice_d256, Absent, vault_siblings_d256)
}

// Mở vault lần hai: gốc hiện tại đã có alice Live, khai Absent để lọt cổng.
test d256_register_rejects_second_vault_claiming_absent() {
  !register_transition_ok(vault_root_new_d256, vault_root_new_d256, key_alice_d256, Absent, vault_siblings_d256)
}

// Mở vault lần hai, khai thật Live: bị chặn ngay ở old_status != Live.
test d256_register_rejects_second_vault_claiming_live() {
  !register_transition_ok(vault_root_new_d256, vault_root_new_d256, key_alice_d256, Live, vault_siblings_d256)
}

test d256_register_rejects_bogus_new_root() {
  !register_transition_ok(vault_root_old_d256, vault_root_bogus_d256, key_alice_d256, Absent, vault_siblings_d256)
}

test d256_register_rejects_one_flipped_sibling() {
  !register_transition_ok(vault_root_old_d256, vault_root_new_d256, key_alice_d256, Absent, vault_siblings_flipped_d256)
}

// ── depth 256 · (ii)+(iv) trong CÙNG một lần chạy ────────────────────────────
test d256_membership_and_register_ok() {
  and {
    verify(phoenix_root_d256, key_alice_d256, Live, phoenix_siblings_d256),
    register_transition_ok(vault_root_old_d256, vault_root_new_d256, key_alice_d256, Absent, vault_siblings_d256),
  }
}
