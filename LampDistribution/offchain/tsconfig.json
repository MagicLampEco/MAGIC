{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "NodeNext",
    "moduleResolution": "NodeNext",
    "lib":              ["ES2022"],
    "strict":           true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "skipLibCheck":     true,
    "outDir":           "./dist",
    "rootDir":          "..",
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true
  },
  "include": ["src/**/*", "../tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
