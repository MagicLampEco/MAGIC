{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "NodeNext",
    "moduleResolution": "NodeNext",
    "lib":              ["ES2022"],
    "strict":           true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "skipLibCheck":     true,
    "noEmit":           true,
    "types":            ["node"],
    "allowJs":          false,
    "esModuleInterop":  true
  },
  "include": ["*.ts", "../offchain/src/**/*.ts"],
  "exclude": ["node_modules", "deployed.json"]
}
