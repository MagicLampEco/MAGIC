{
  "name": "@magiclamp/vault-read-api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Mặt tiền ĐỌC-THÔI cho vault MAGIC — sidecar HTTP để backend không-TypeScript (Java) đọc số MAGIC thật mà không phải chép lại cách giải mã datum.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "probe": "tsx scripts/probe.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "0.4.30",
    "@magiclamp/protocol-utils": "file:../ProtocolUtils",
    "@magiclamp/sdk": "file:../MagicSDK"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.7.10"
  }
}
