{
  "contract_version": "1.0.0",
  "description": "Error codes of the routes in openapi.json. Every non-2xx body is the ErrorResponse envelope. status lists the HTTP statuses the code is returned with. routes lists the path ids the code can appear on; '*' means every route except /health. The table is what the server documents today, not a promise of exhaustiveness: a reader must handle an unknown code by its HTTP status (see compatibility.md).",
  "codes": [
    {
      "code": "BAD_REQUEST",
      "status": [
        400
      ],
      "routes": [
        "*"
      ],
      "meaning": "Request body is not a JSON object, or a field is missing or malformed. Read error.message."
    },
    {
      "code": "UNAUTHORIZED",
      "status": [
        401
      ],
      "routes": [
        "*"
      ],
      "meaning": "Missing or wrong Authorization bearer token."
    },
    {
      "code": "NOT_FOUND",
      "status": [
        404
      ],
      "routes": [
        "*"
      ],
      "meaning": "Unknown path."
    },
    {
      "code": "METHOD_NOT_ALLOWED",
      "status": [
        405
      ],
      "routes": [
        "*"
      ],
      "meaning": "Wrong HTTP method for the path."
    },
    {
      "code": "INTERNAL",
      "status": [
        500
      ],
      "routes": [
        "*"
      ],
      "meaning": "Unexpected server error. error.details.reference_code (ref_<12 hex>) is the handle to quote to the operator; never retry blindly."
    },
    {
      "code": "CONFIG_MISSING",
      "status": [
        501
      ],
      "routes": [
        "*"
      ],
      "meaning": "The deployment lacks configuration this route needs; error.details.missing names it. Not retryable."
    },
    {
      "code": "CHAIN_UNAVAILABLE",
      "status": [
        502
      ],
      "routes": [
        "*"
      ],
      "meaning": "The chain data provider failed or returned an inconsistent snapshot. Retryable; do not read it as 'not found'."
    },
    {
      "code": "FEE_PROXY_UNAVAILABLE",
      "status": [
        501
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign"
      ],
      "meaning": "The deployment has no feecover block."
    },
    {
      "code": "FEE_PROXY_APP_UNKNOWN",
      "status": [
        401
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign",
        "/tx/quote"
      ],
      "meaning": "X-Feecover-Token matches no configured application, or no default application exists."
    },
    {
      "code": "FEE_PROXY_PURPOSE_UNMAPPED",
      "status": [
        400
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign"
      ],
      "meaning": "The application has no Feecover purpose for this route."
    },
    {
      "code": "FEE_PROXY_APP_PURPOSE",
      "status": [
        403
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign"
      ],
      "meaning": "The purpose belongs to another application or lacks the application prefix."
    },
    {
      "code": "FEE_PROXY_SOURCE_INVALID",
      "status": [
        400
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign"
      ],
      "meaning": "source is neither feecover nor sponsor."
    },
    {
      "code": "FEE_PROXY_REJECTED",
      "status": [
        400,
        403,
        409,
        422,
        429
      ],
      "routes": [
        "/fee/utxo",
        "/fee/sign"
