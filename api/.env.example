# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/otc_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_min_32_chars

# Internal oracle shared secret (mTLS CN in production)
ORACLE_SECRET=change_me_oracle_secret

# Blockfrost (Cardano chain indexer fallback)
BLOCKFROST_PROJECT_ID=preview_xxxxxxxxxxxx
BLOCKFROST_NETWORK=preview

# Enterprise API key prefix
API_KEY_PREFIX=ent_live_

# VietQR merchant info defaults
DEFAULT_BANK_CODE=VCB
DEFAULT_ACCOUNT_NUMBER=1234567890
DEFAULT_ACCOUNT_NAME=CONG TY MAGICLAMP NETWORK
DEFAULT_MERCHANT_NAME=MAGICLAMP NETWORK

# Order TTL seconds (default 900 = 15 min)
ORDER_TTL_SECONDS=900

# Redis lock TTL ms
LOCK_TTL_MS=2000

# Base URL for QR image links
BASE_URL=https://otc.magiclamp.network/api
