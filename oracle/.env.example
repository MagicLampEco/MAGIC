# ── Oracle key material ─────────────────────────────────────────────────────
# Generate with: node -e "const {ed25519}=require('@noble/curves/ed25519'); const k=ed25519.utils.randomPrivateKey(); console.log('PRIV:',Buffer.from(k).toString('hex')); console.log('PUB:',Buffer.from(ed25519.getPublicKey(k)).toString('hex'))"
ORACLE_PRIVATE_KEY=<64-char hex — 32 bytes Ed25519 private key seed>
ORACLE_PUBLIC_KEY=<64-char hex — 32 bytes Ed25519 public key>

# ── PayOS ────────────────────────────────────────────────────────────────────
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ── MB Bank ──────────────────────────────────────────────────────────────────
MB_BANK_ACCOUNT_NUMBER=0123456789
MB_BANK_USERNAME=your_mb_username
MB_BANK_PASSWORD=your_mb_password
MB_BANK_API_BASE_URL=https://api.mbbank.com.vn/v2
MB_BANK_POLL_INTERVAL_MS=30000

# ── Cardano / Blockfrost ─────────────────────────────────────────────────────
CARDANO_NETWORK=preview
BLOCKFROST_API_KEY=previewABCDEF...

# ── OTC Contract ─────────────────────────────────────────────────────────────
OTC_SCRIPT_ADDRESS=addr_test1...
OTC_SCRIPT_CBOR=<hex CBOR of compiled Aiken script>
# Oracle fee wallet: Ed25519 extended private key (cborHex from cardano-cli keygen)
ORACLE_FEE_WALLET_SKEY=5820<128 hex chars>

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vedata:password@localhost:5432/vedata_oracle

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Bank settlement account (shown on VietQR) ────────────────────────────────
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=CONG TY TNHH VEDATA
BANK_BIN=970422

# ── Oracle tuning ─────────────────────────────────────────────────────────────
RELEASE_SIGNATURE_TTL_MINUTES=15
ORDER_EXPIRY_MINUTES=30
CONFIRMATION_DEPTH=3
MAX_RESIGN_COUNT=5

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3100
WEBHOOK_PATH_PAYOS=/webhook/payos
WEBHOOK_PATH_MBBANK=/webhook/mbbank

# ── Alerting (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
OPS_EMAIL=ops@yourcompany.com

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
