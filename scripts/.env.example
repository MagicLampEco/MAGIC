# MagicLamp — mẫu `.env` cho scripts deploy/test. Copy thành `.env`.
#
# ⛔ TỆP NÀY KHÔNG CHỨA SECRET, VÀ `.env` CŨNG KHÔNG ĐƯỢC CHỨA.
#
# `BLOCKFROST_KEY` và seed ví deploy nằm ở `$AGENT_SECRETS` — nguồn duy nhất.
# `run_consume_e2e.sh` tự đọc từ đó rồi export vào môi trường (dòng 46-53), và
# `detect_deploy_wallet.ts` dò đúng biến seed mà không in giá trị ra.
# Chạy tay từng bước thì export trước khi gọi script:
#
#   export BLOCKFROST_KEY="$(grep '^Blockfrost_GreenSun_Preview=' "$AGENT_SECRETS" | cut -d= -f2-)"
#   export WALLET_SEED="$(grep "^$(npx tsx detect_deploy_wallet.ts)=" "$AGENT_SECRETS" | cut -d= -f2-)"
#
# `config.ts` nhận `PRIVATE_KEY` HOẶC `WALLET_SEED` — nhưng đọc qua `process.env`,
# nên biến đã export luôn dùng được mà không cần ghi xuống đĩa. Ghi secret vào
# `.env` là tạo bản sao thứ hai của thứ chỉ nên có một bản.
# Nguồn: `ConsumeMAGIC/EXEC.md §1`.

# ── Mạng ──────────────────────────────────────────────────────
NETWORK=Preview

# ── Script hash (điền sau `aiken build` từng module) ──────────
# cd <Module>/onchain && aiken build && jq '.validators[0].hash' plutus.json
VAULT_INSTANT_HASH=FILL_AFTER_AIKEN_BUILD
VAULT_SCHEDULE_HASH=FILL_AFTER_AIKEN_BUILD
SHARD_HASH=FILL_AFTER_AIKEN_BUILD
UM_DATUM_HASH=FILL_AFTER_AIKEN_BUILD

# ── Policy ID (điền sau khi deploy) ──────────────────────────
LAMP_POLICY_ID=FILL_AFTER_STEP_01
UM_NFT_POLICY_ID=FILL_AFTER_STEP_02
SHARD_NFT_POLICY_ID=FILL_AFTER_STEP_03

# ── Địa chỉ ───────────────────────────────────────────────────
TREASURY_ADDRESS=FILL_AFTER_DEPLOY
VAULT_OWNER_PKH=FILL_AFTER_STEP_05

# ── BackingBeacon (§6.3, chờ CARP) ───────────────────────────
# Bỏ trống là ĐÚNG: default all-zero ⇒ InstantGen fail-closed (Gen ĐÓNG).
# Đừng bịa giá trị để "cho nó chạy".
# BACKING_SCRIPT_HASH=
# BACKING_NFT_POLICY_ID=

# ── Knob ConsumeMAGIC (bước 09 — mặc định có sẵn) ────────────
# MAX_PRICE_STALE=1              # epoch giá được phép cũ; BAKED vào consume hash
# PRICE_COMMITTEE=<pkh,pkh>      # default = ví deploy
# PRICE_THRESHOLD=1              # M-of-N
# PRICE_DEMAND_MULT=1000000000   # Q-format, 1.0×
