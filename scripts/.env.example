# MagicLamp Testnet Config — KHÔNG commit file này!
# Copy file này thành .env và điền các giá trị

# ── Network ───────────────────────────────────────────────────
NETWORK=Preview
BLOCKFROST_KEY=previewXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Wallet private key (ed25519) ──────────────────────────────
# Lấy từ: Eternl wallet → Settings → Export private key
# CẢNH BÁO: Chỉ dùng wallet testnet, KHÔNG dùng mainnet wallet
PRIVATE_KEY=ed25519_sk1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Script hashes (điền sau khi aiken build) ─────────────────
# cd InstantGen/onchain && aiken build
# cat plutus.json | jq '.validators[0].hash'
VAULT_INSTANT_HASH=FILL_AFTER_AIKEN_BUILD
VAULT_SNAPSHOT_HASH=FILL_AFTER_AIKEN_BUILD
VAULT_VACUUM_HASH=FILL_AFTER_AIKEN_BUILD
VAULT_SCHEDULE_HASH=FILL_AFTER_AIKEN_BUILD
SHARD_HASH=FILL_AFTER_AIKEN_BUILD
UM_DATUM_HASH=FILL_AFTER_AIKEN_BUILD

# ── Policy IDs (điền sau khi deploy) ─────────────────────────
LAMP_POLICY_ID=FILL_AFTER_STEP_01
UM_NFT_POLICY_ID=FILL_AFTER_STEP_02
SHARD_NFT_POLICY_ID=FILL_AFTER_STEP_03

# ── Addresses ─────────────────────────────────────────────────
TREASURY_ADDRESS=FILL_AFTER_DEPLOY
VAULT_OWNER_PKH=FILL_AFTER_STEP_04
