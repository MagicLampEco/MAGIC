{
  "name": "@magiclamp/scripts",
  "version": "0.1.0",
  "type": "module",
  "description": "Deploy + test scripts for MagicLamp Preview testnet",
  "scripts": {
    "deploy:all":    "npm run deploy:lamp && npm run deploy:um && npm run deploy:shards && npm run deploy:vault",
    "deploy:lamp":   "npx tsx deploy/01_mint_lamp.ts",
    "deploy:um":     "npx tsx deploy/02_deploy_um.ts",
    "deploy:shards": "npx tsx deploy/03_deploy_shards.ts",
    "deploy:vault":  "npx tsx deploy/04_create_vault.ts",
    "verify:hashes": "npx tsx verify_per_network.ts",
    "test:snapshot":         "npx tsx test/snapshot_only.ts",
    "test:instant":          "npx tsx test/instant_only.ts",
    "deploy:instant-vault":  "npx tsx deploy/05_create_instant_vault.ts",
    "deploy:vacuum-vault":   "npx tsx deploy/06_create_vacuum_vault.ts",
    "test:vacuum-commit":    "npx tsx test/vacuum_commit_only.ts",
    "test:vacuum-fire":      "npx tsx test/vacuum_fire_only.ts",
    "deploy:schedule-vault": "npx tsx deploy/07_create_schedule_vault.ts",
    "test:schedule-commit":  "npx tsx test/schedule_commit_only.ts",
    "test:schedule-fire":    "npx tsx test/schedule_fire_only.ts"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "^0.4.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "tsx":        "^4.7.0",
    "typescript": "^5.4.0"
  }
}
